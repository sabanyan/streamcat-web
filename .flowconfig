[ignore]
<PROJECT_ROOT>/node_modules/.*
<PROJECT_ROOT>/public/.*
<PROJECT_ROOT>/kskp/.*
<PROJECT_ROOT>/dist/.*
<PROJECT_ROOT>/src/lib/.*
<PROJECT_ROOT>webpack.config.js
[include]

[libs]
./src/lib/libdefs.js
[lints]

[options]
#ref:https://github.com/facebook/flow/issues/338
module.file_ext=.js
module.file_ext=.jsx
module.file_ext=.json
module.file_ext=.css
module.file_ext=.less
module.file_ext=.scss
#ref:https://flow.org/en/docs/config/options/
module.system.node.resolve_dirname=node_modules
[strict]
