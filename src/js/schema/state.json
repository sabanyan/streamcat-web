{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "title": "The Root Schema",
  "required": [
    "selected_step_ids",
    "graph",
    "zoom",
    "nodes",
    "mast",
    "selected_tab_id",
    "drag",
    "selected_in_edges",
    "selected_out_edges",
    "selected_data_source_detail"
  ],
  "properties": {
    "selected_step_ids": {
      "$id": "#/properties/selected_step_ids",
      "type": "array",
      "title": "The Selected_step_ids Schema"
    },
    "graph": {
      "$id": "#/properties/graph",
      "type": "object",
      "title": "The Graph Schema",
      "required": [
        "width",
        "height",
        "nodes",
        "edges"
      ],
      "properties": {
        "width": {
          "$id": "#/properties/graph/properties/width",
          "type": "null",
          "title": "The Width Schema",
          "default": null,
          "examples": [
            null
          ]
        },
        "height": {
          "$id": "#/properties/graph/properties/height",
          "type": "null",
          "title": "The Height Schema",
          "default": null,
          "examples": [
            null
          ]
        },
        "nodes": {
          "$id": "#/properties/graph/properties/nodes",
          "type": "array",
          "title": "The Nodes Schema"
        },
        "edges": {
          "$id": "#/properties/graph/properties/edges",
          "type": "array",
          "title": "The Edges Schema"
        }
      }
    },
    "zoom": {
      "$id": "#/properties/zoom",
      "type": "integer",
      "title": "The Zoom Schema",
      "default": 0,
      "examples": [
        100
      ]
    },
    "nodes": {
      "$id": "#/properties/nodes",
      "type": "array",
      "title": "The Nodes Schema"
    },
    "mast": {
      "$id": "#/properties/mast",
      "type": "object",
      "title": "The Mast Schema"
    },
    "selected_tab_id": {
      "$id": "#/properties/selected_tab_id",
      "type": "integer",
      "title": "The Selected_tab_id Schema",
      "default": 0,
      "examples": [
        0
      ]
    },
    "drag": {
      "$id": "#/properties/drag",
      "type": "object",
      "title": "The Drag Schema"
    },
    "selected_in_edges": {
      "$id": "#/properties/selected_in_edges",
      "type": "array",
      "title": "The Selected_in_edges Schema"
    },
    "selected_out_edges": {
      "$id": "#/properties/selected_out_edges",
      "type": "array",
      "title": "The Selected_out_edges Schema"
    },
    "selected_data_source_detail": {
      "$id": "#/properties/selected_data_source_detail",
      "type": "object",
      "title": "The Selected_data_source_detail Schema"
    }
  }
}