{
  "name": "kskp-beta",
  "version": "1.0.0",
  "description": "kskp-beta",
  "main": "index.js",
  "scripts": {
    "dll": "npx webpack --config webpack.dll.config.js",
    "build": "npx webpack",
    "start": "npx webpack --watch -d --mode=development",
    "production": "npx webpack --watch -d --mode=production & webpack-dev-server --content-base public/",
    "test": "jest",
    "testwatch": "jest --watchAll",
    "testcoverage": "jest --coverage",
    "flow": "flow",
    "flowcoverage": "flow-coverage-report -i 'src/**/*.js' -i 'src/**/*.jsx' -x 'src/test/**' -t html -t json -t text"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(css|scss)$": "identity-obj-proxy"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksk-anl/kskp-beta.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ksk-anl/kskp-beta/issues"
  },
  "homepage": "https://github.com/ksk-anl/kskp-beta#readme",
  "devDependencies": {
    "axios": "^0.18.0",
    "babel-loader": "^7.1.4",
    "babel-preset-env": "^1.7.0",
    "babel-preset-flow": "^6.23.0",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-2": "^6.24.1",
    "boiler_strap": "git+https://c80fb19e1ee1f1071186b7f5224cadeb8f2596e2:x-oauth-basic@github.com/IMPATH/KSKPStrap.git#master",
    "bootstrap": "^4.1.1",
    "css-loader": "^0.28.11",
    "extract-text-webpack-plugin": "^4.0.0-beta.0",
    "flow-bin": "^0.72.0",
    "flow-coverage-report": "^0.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^23.5.0",
    "node-sass": "^4.9.0",
    "react-test-renderer": "^16.4.2",
    "sass-loader": "^7.0.1",
    "style-loader": "^0.21.0",
    "webpack": "^4.6.0",
    "webpack-cli": "^2.1.3",
    "webpack-dev-server": "^3.1.4"
  },
  "dependencies": {
    "ajv": "^6.5.4",
    "chart.js": "^2.7.2",
    "classnames": "^2.2.5",
    "dagre": "^0.8.2",
    "eventemitter3": "^3.1.0",
    "lodash": "^4.17.5",
    "moment": "^2.22.2",
    "react": "^16.3.2",
    "react-chartjs-2": "^2.7.2",
    "react-dom": "^16.3.2",
    "react-redux": "^5.0.7",
    "redux": "^4.0.0"
  }
