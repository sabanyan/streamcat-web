{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "CommandModelSchema.json",
  "type": "object",
  "required": [
    "args",
    "commandId",
    "dsts",
    "id",
    "position",
    "size",
    "srcs",
    "type"
  ],
  "properties": {
    "args": {
      "$id": "#/properties/args",
      "type": "object"
    },
    "commandId": {
      "$id": "#/properties/commandId",
      "type": "string",
      "pattern": "^(.*)$"
    },
    "dsts": {
      "$id": "#/properties/dsts",
      "type": "object"
    },
    "id": {
      "$id": "#/properties/id",
      "type": "string",
      "pattern": "^(.*)$"
    },
    "position": {
      "$id": "#/properties/position",
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$id": "#/properties/position/properties/x",
          "type": "integer"
        },
        "y": {
          "$id": "#/properties/position/properties/y",
          "type": "integer"
        }
      }
    },
    "size": {
      "$id": "#/properties/size",
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "$id": "#/properties/size/properties/width",
          "type": "integer"
        },
        "height": {
          "$id": "#/properties/size/properties/height",
          "type": "integer"
        }
      }
    },
    "srcs": {
      "$id": "#/properties/srcs",
      "type": "object"
    },
    "type": {
      "$id": "#/properties/type",
      "type": "string",
      "pattern": "^(.*)$"
    }
  }
}