{
  "id": "mbest",
  "rules": {
    "s":{
      "presencesIfTargetIsNotInput" : "q",
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(%n|%r|%nr)?(,[^,]+(%n|%r|%nr)?)*$|^$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(%n|%r|%nr)?)*$|^@\\[.+\\](%n|%r|%nr)?$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "fr" : {
      "format" : {
        "pattern": "^[1-9]?[0-9]*$|^MIN$|$^0$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      },
      "onlyOneInput" : {
        "target" : ["size"]
      }
    },
    "to":{
      "format" : {
        "pattern": "^[1-9]?[0-9]*$|^MAX$|^0$|^@\\[.+\\]$",
        "message": "0以上の整数を半角で入力してください"
      },
      "onlyOneInput" : {
        "target" : ["size"]
      },
      "compareNumbersLargerThan" : {
        "target" : "fr",
        "message" : "frより数値が大きくなるよう入力してください。"
      }
    },
    "size":{
      "onlyOneInput" : {
        "target" : ["to", "fr"]
      },
      "format" : {
        "pattern": "^[1-9]?[0-9]*$|^@\\[.+\\]$",
        "message": "1以上の整数を半角で入力してください"
      }
    },
    "k":{
      "checkSeveralSpecifiedFormats" : {
        "defaultRule" : {
          "pattern" : "^[^,]+(,[^,]+)*$|^$",
          "message" : "入力値が正しくありません。"
        },
        "specialRules" : [
          {
            "target" : ["x", "nfn"],
            "pattern" : "^[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?(,[1-9]?[0-9]+L?(-[1-9]?[0-9]+)?L?)*$|^@\\[.+\\]$|^$",
            "message" : "項目の指定は数値のみ可能です。"
          }
        ]
      }
    },
    "R" : {
      "specifiedFormatIfTargetInput" : {
        "target": ["R"],
        "pattern": "^(MIN|(\\+|-)?[1-9]?[0-9]+(\\.[0-9]*)?),((MAX|(\\+|-)?[1-9]?[0-9]+(\\.[0-9]*)?))$|^@\\[.+\\]$",
        "message": "2項目での数値範囲の指定は,(コンマ)で区切って入力してください。また、MINはコンマの左側、MAXはコンマの右側のみに入力可能です。"
      }
    }
  },
  "params": [
    {
      "name": "s",
      "type": "string",
      "label": "ソート対象列名"
    },
    {
      "name": "fr",
      "type": "string",
      "label": "選択する開始行番号",
      "optional": true,
      "default": 0
    },
    {
      "name": "to",
      "type": "string",
      "label": "選択する終了行番号",
      "optional": true,
      "default": 0
    },
    {
      "name": "size",
      "type": "string",
      "label": "選択する行数",
      "optional": true,
      "default": 1
    },
    {
      "name": "k",
      "type": "string",
      "label": "指定列が同じ値の行ごとにfr=,to=,sizeで指定した行番号の行を選択",
      "optional": true
    },
    {
      "name": "R",
      "type": "string",
      "label": "行番号範囲リスト (複数項目指定可)",
      "optional": true
    },
    {
      "name": "r",
      "type": "boolean",
      "label": "fr=,to=(size=) パラメータで指定した行番号以外の行を選択する",
      "optional": true
    },
    {
      "name": "assert_diffSize",
      "type": "boolean",
      "label": "入力、出力件数比較を行う",
      "optional": true
    },
    {
      "name": "assert_nullkey",
      "type": "boolean",
      "label": "キー項目にNULL値が含まれているかどうかのチェックを行う",
      "optional": true
    },
    {
      "name": "nfn",
      "type": "boolean",
      "label": "入力データの1行目を項目名行とみなさない。",
      "optional": true
    },
    {
      "name": "nfno",
      "type": "boolean",
      "label": "出力データに項目名行を出力しない。",
      "optional": true
    },
    {
      "name": "x",
      "type": "boolean",
      "label": "項目番号による指定",
      "optional": true
    },
    {
      "name": "q",
      "type": "boolean",
      "label": "自動並べ替えの無効化",
      "optional": true
    },
    {
      "name": "tmpPath",
      "type": "string",
      "label": "作業ファイル格納パス名",
      "optional": true
    }
  ],
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      },
      {
        "name": "u",
        "type": "frame"
      }
    ]
  ],
  "version": "0.7.0",
  "label": "指定行選択",
  "classification": "row_edit",
  "description": "指定した行番号の行を選択する。行番号は0から始まる。",
  "url": "./static/pdf/mcmd/row_edit/mbest.pdf"
}