{
  "version": "0.7.0",
  "id": "csvtoscatter",
  "label": "散布図の作成",
  "classification": "visualize",
  "description": "csvファイルから散布図を作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "offsrt",
      "type": "number",
      "label": "ビジュアライズを行う開始行"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "ビジュアライズ対象のデータ数"
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "ビジュアライズの横サイズ",
      "default": 1400
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "ビジュアライズの縦サイズ",
      "default": 600
    },
    {
      "name": "graph_title",
      "type": "string",
      "label": "ビジュアライズのタイトル"
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    },
    {
      "name": "alpha",
      "type": "number",
      "label": "透明度",
      "default": 1
    },
    {
      "name": "x_axis",
      "type": "string",
      "label": "x軸に表示する列名"
    },
    {
      "name": "y_axis",
      "type": "string",
      "label": "y軸に表示する列名"
    },
    {
      "name": "data_column",
      "type": "string",
      "label": "ビジュアライズ対象の項目が入っている列名"
    },
    {
      "name": "data",
      "type": "column",
      "label": "ビジュアライズ対象の項目（空の場合は全て表示）"
    }
  ],
  "url": ""
}
