{
  "version": "0.7.0",
  "id": "csvtoboxplot",
  "label": "箱ひげ図の作成",
  "classification": "visualize",
  "description": "csvファイルから箱ひげ図を作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "offsrt",
      "type": "number",
      "label": "ビジュアライズを行う開始行"
    },
    {
      "name": "limit",
      "type": "number",
      "label": "ビジュアライズ対象のデータ数"
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "ビジュアライズの横サイズ",
      "default": 1400
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "ビジュアライズの縦サイズ",
      "default": 600
    },
    {
      "name": "graph_title",
      "type": "string",
      "label": "ビジュアライズのタイトル"
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    },
    {
      "name": "x_axis",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "x軸に表示する列名"
    },
    {
      "name": "y_axis",
      "type": "column",
      "options":{
        "multiple": false
      },
      "label": "y軸に表示する列名"
    }
  ],
  "url": ""
}
