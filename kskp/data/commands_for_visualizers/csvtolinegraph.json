{
  "version": "0.7.0",
  "id": "csvtolinegraph",
  "label": "折れ線グラフの作成（時系列データ用）",
  "classification": "visualize",
  "description": "csvファイルから折れ線グラフを作成する",
  "ports": [
    [
      {
        "name": "i",
        "type": "frame"
      }
    ],
    [
      {
        "name": "o",
        "type": "frame"
      }
    ]
  ],
  "params": [
    {
      "name": "limit",
      "type": "number",
      "label": "ビジュアライズを出力するデータの限度数"
    },
    {
      "name": "offset",
      "type": "number",
      "label": "ビジュアライズを出力するデータの開始位置"
    },
    {
      "name": "x_size",
      "type": "number",
      "label": "生成する画像の横の長さ（インチ）"
    },
    {
      "name": "y_size",
      "type": "number",
      "label": "生成する画像の縦の長さ（インチ）"
    },
    {
      "name": "time_series_column",
      "type": "string",
      "label": "時系列を示している列名"
    },
    {
      "name": "graph_title",
      "type": "string",
      "label": "グラフのタイトル"
    },
    {
      "name": "x_label",
      "type": "string",
      "label": "x軸のラベル"
    },
    {
      "name": "y_label",
      "type": "string",
      "label": "y軸のラベル"
    },
    {
      "name": "x_axis_column",
      "type": "string",
      "label": "x軸に対応する列名"
    },
    {
      "name": "y_axis_column",
      "type": "string",
      "label": "y軸に対応する列名"
    },
    {
      "name": "data_column",
      "type": "string",
      "label": "グラフに出力するデータの列名"
    }
  ],
  "url": ""
}
