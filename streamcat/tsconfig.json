{
    "compilerOptions": {
        // 
        // Basic Options
        // 
        "baseUrl": "./",
        // tsを書くときにどのversionのESが対象か: 'ES3'(default), 'ES5', 'ES2015', 'ES2016', 'ES2017','ES2018' or 'ESNEXT'
        "target": "ES2015",
        // どのversionのESを生成するか: 'none', 'commonjs', 'amd', 'system', 'umd', 'es2015', or 'ESNext'
        "module": "es2015",
        // reactを書くときに必要, 'react-native', or 'react'
        "jsx": "react",

        // 
        // Strict Type-Checking Options
        // 
        // すべての strict タイプ・オプション(noImplicitAny, strictNullChecks, noImplicitThis(thisの型チェック),
        // alwaysStrict(strictモードのjs出力))を有効化する
        "strict": true,
        // any型の使用不可
        "noImplicitAny": false,
        // nullable型以外でnullを許容しない
        "strictNullChecks": true,
        "allowSyntheticDefaultImports": true,

        // 
        // Additional Checks
        // 
        // 未使用の変数を許容しない
        "noUnusedLocals": false,
        // 未使用の変数を許容しない
        "noUnusedParameters": false,
        // メソッド内で返り値の型があっているかをチェック
        "noImplicitReturns": true,

        //
        // Alias Path
        // (WebPackのAlias設定も忘れずに)
        "paths": {
            "Components/*": ["./web/frontend/js/components/*"],
            "FlowEditorContainer/*": ["./web/frontend/js/components/FlowEditorContainer/*"],
            "LibraryContainer/*"   : ["./web/frontend/js/components/LibraryContainer/*"],
            "ProfileContainer/*"   : ["./web/frontend/js/components/ProfileContainer/*"],
            "PreviewContainer/*"   : ["./web/frontend/js/components/PreviewContainer/*"],
            "UserListContainer/*"  : ["./web/frontend/js/components/admin/UserListContainer/*"],
            "Shared/*"   : ["./web/frontend/js/components/shared/*"],
            "Constants/*": ["./web/frontend/js/constants/*"],
            "Model/*": ["./web/frontend/js/model/*"],
            "Modules/*": ["./web/frontend/js/modules/*"],
            "Types/*": ["./web/frontend/js/types/*"],
            "Utils/*": ["./web/frontend/js/utils/*"],
            "Api"    : ["./web/frontend/js/api"]
        },

        // 
        // Module Resolution Options
        // (参照: http://js.studio-kingdom.com/typescript/handbook/module_resolution)
        "moduleResolution": "node",
        /* ESModuleと同じ動作をする. */
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "node_modules",
        "build",
        "scripts",
        "webpack",
        "jest"
    ]
}
