{
	"name": "streamcat",
	"version": "3.3.0",
	"description": "A data-analysis software, StreamCat",
	"author": "StreamCat developers",
	"license": "AGPL-3.0-only",
	"homepage": "https://www.kskp.io/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sabanyan/streamcat-web.git"
	},
	"bugs": {
		"url": "https://github.com/sabanyan/streamcat-web/issues"
	},
	"main": "index.js",
	"scripts": {
		"start": "npx webpack --config webpack.dll.config.js --env=development && npx webpack --env=development --watch",
		"build": "npx webpack --config webpack.dll.config.js --env=production  && npx webpack --env=production",
		"dll"  : "npx webpack --config webpack.dll.config.js",
		"lint": "npx eslint .",
		"test": "jest --maxWorkers=1",
		"testwatch": "jest --watchAll",
		"testupdate": "jest --update-snapshot",
		"testcoverage": "jest --coverage",
		"flow": "flow",
		"flowcoverage": "flow-coverage-report -i 'src/**/*.js' -i 'src/**/*.jsx' -x 'src/test/**' -t html -t json -t text"
	},
	"dependencies": {
		"dagre": "^0.8.5",
		"eventemitter3": "^5.0.0",
		"lodash": "^4.17.21",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"react-redux": "^8.0.5",
		"react-select": "^5.7.0",
		"redux": "^4.2.1",
		"redux-thunk": "^2.4.2",
		"use-async-resource": "^2.2.2"
	},
	"devDependencies": {
		"@babel/core": "^7.20.12",
		"@babel/preset-env": "^7.20.2",
		"@babel/preset-flow": "^7.18.6",
		"@babel/preset-react": "^7.18.6",
		"@babel/preset-typescript": "^7.18.6",
		"@emotion/react": "^11.10.6",
		"@emotion/styled": "^11.10.6",
		"@mui/material": "^5.11.10",
		"@mui/x-date-pickers": "^5.0.19",
		"@redux-devtools/extension": "^3.2.5",
		"@types/lodash": "^4.14.191",
		"@types/react": "^17.0.41",
		"@types/react-dom": "^17.0.14",
		"array-move": "^4.0.0",
		"babel-loader": "^9.1.2",
		"bootstrap": "^5.2.3",
		"classnames": "^2.3.2",
		"css-loader": "^6.7.3",
		"dayjs": "^1.11.7",
		"flow-bin": "^0.200.0",
		"flow-coverage-report": "^0.8.0",
		"jest": "^27.2.5",
		"mini-css-extract-plugin": "^2.7.2",
		"react-app-polyfill": "^3.0.0",
		"react-hook-form": "^7.43.1",
		"react-i18next": "^12.1.5",
		"react-sortable-hoc": "^2.0.0",
		"react-test-renderer": "^17.0.2",
		"reapop": "^4.2.1",
		"sass": "^1.58.3",
		"sass-loader": "^13.2.0",
		"style-loader": "^3.3.1",
		"ts-loader": "^9.4.2",
		"typescript": "^4.9.5",
		"use-interval": "^1.4.0",
		"validate.js": "^0.13.1",
		"webpack": "^5.75.0",
		"webpack-cli": "^5.0.1"
	},
	"jest": {
		"roots": [
			"<rootDir>/web/frontend/js"
		],
		"collectCoverageFrom": [
			"js/**/*.{js,jsx,ts,tsx}",
			"!js/**/*.d.ts"
		],
		"setupFiles": [
			"react-app-polyfill/jsdom"
		],
		"testMatch": [
			"<rootDir>/web/frontend/js/**/__tests__/**/*.{js,jsx,ts,tsx}",
			"<rootDir>/web/frontend/js/**/*.{spec,test}.{js,jsx,ts,tsx}"
		],
		"testEnvironment": "jsdom",
		"transform": {
			"^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/web/frontend/config/jest/babelTransform.js",
			"^.+\\.css$": "<rootDir>/web/frontend/config/jest/cssTransform.js",
			"^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/web/frontend/config/jest/fileTransform.js"
		},
		"transformIgnorePatterns": [
			"[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$",
			"^.+\\.module\\.(css|sass|scss)$"
		],
		"modulePaths": [
			"<rootDir>/web/frontend/js",
			"<rootDir>/web/frontend/js/components"
		],
		"moduleNameMapper": {
			"^react-native$": "react-native-web",
			"^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
		},
		"moduleFileExtensions": [
			"web.js",
			"js",
			"web.ts",
			"ts",
			"web.tsx",
			"tsx",
			"json",
			"web.jsx",
			"jsx",
			"node"
		],
		"resetMocks": true
	}
}
