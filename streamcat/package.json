{
	"name": "streamcat",
	"version": "3.6",
	"description": "A data-analysis software, StreamCat",
	"author": "StreamCat developers",
	"license": "AGPL-3.0-only",
	"homepage": "https://www.kskp.io/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sabanyan/streamcat-web.git"
	},
	"bugs": {
		"url": "https://github.com/sabanyan/streamcat-web/issues"
	},
	"main": "index.js",
	"scripts": {
		"reinstall": "rm -rf package-lock.json node_modules && npm install",
		"start": "npx webpack --config webpack.dll.config.js --env=development && npx webpack --env=development --watch",
		"build": "npx webpack --config webpack.dll.config.js --env=production  && npx webpack --env=production",
		"lint": "npx eslint .",
		"test": "jest --config ./web/frontend/config/jest.config.js",
		"testwatch": "jest --config ./web/frontend/config/jest.config.js --watchAll",
		"testupdate": "jest --config ./web/frontend/config/jest.config.js --update-snapshot",
		"testcoverage": "jest --config ./web/frontend/config/jest.config.js  --coverage"
	},
	"dependencies": {
		"@amreraky/react-infinite-scroller": "2.0.5",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/material": "7.3.8",
		"@mui/x-date-pickers": "8.27.0",
		"bootstrap": "5.3.8",
		"classnames": "2.5.1",
		"css-loader": "7.1.4",
		"dagre": "0.8.5",
		"dayjs": "1.11.19",
		"eventemitter3": "5.0.4",
		"fast-json-patch": "3.1.1",
		"lodash-core": "4.17.19",
		"mini-css-extract-plugin": "2.10.0",
		"react": "19.2.4",
		"react-dnd": "16.0.1",
		"react-dnd-html5-backend": "16.0.1",
		"react-dom": "19.2.4",
		"reapop": "4.3.0",
		"sass": "1.97.3",
		"sass-loader": "16.0.7",
		"style-loader": "4.0.0",
		"suspend-react": "^0.1.3",
		"ts-loader": "9.5.4",
		"typescript": "5.9.3",
		"use-interval": "1.4.0",
		"webpack-cli": "6.0.1"
	},
	"devDependencies": {
		"@types/jest": "30.0.0",
		"@types/lodash": "4.17.23",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"jest": "30.2.0",
		"react-test-renderer": "19.2.4",
		"ts-jest": "29.4.6"
	}
}
